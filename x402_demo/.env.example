# ── Merchant wallet (receives payments) ──────────────────────────────────────
# Your Base Sepolia wallet address
WALLET_ADDRESS=0xYourMerchantWalletAddressHere

# ── Demo payer wallet (sends payments) ───────────────────────────────────────
# A separate Base Sepolia test wallet private key (used server-side to sign demo payments).
# NEVER use a mainnet private key here. This is for testnet demos only.
PAYER_PRIVATE_KEY=0xYourPayerPrivateKeyHere

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── x402 Facilitator (Coinbase) ───────────────────────────────────────────────
# Validates payments and executes USDC transfers on-chain.
FACILITATOR_URL=https://x402.org/facilitator
